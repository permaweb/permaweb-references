{
  "name": "@permaweb/references",
  "version": "1.1.0",
  "description": "reference@1.0 js client: name resolution and management on the Permaweb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/permaweb/permaweb-references"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "transfer-carrier": "npm run build && node scripts/transfer-carrier.mjs",
    "prepare": "npm run build",
    "test": "vitest run --no-cache",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "arbundles": "^0.11.2",
    "arweave": "^1.15.7"
  },
  "peerDependenciesMeta": {
    "arweave": {
      "optional": true
    },
    "arbundles": {
      "optional": true
    }
  },
  "dependencies": {
    "@dha-team/arbundles": "^1.0.4"
  }
}
